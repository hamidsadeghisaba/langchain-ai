# Task metadata backend: sqlite or postgres
TASK_REPOSITORY_BACKEND=sqlite
# TASK_REPOSITORY_BACKEND=postgres

# when TASK_REPOSITORY_BACKEND=sqlite
WORKFLOW_DB_PATH=data/workflow.sqlite3
# TASK_DATABASE_URL=sqlite:///data/workflow.sqlite3

# when TASK_REPOSITORY_BACKEND=postgres
# TASK_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/workflow
TASK_DB_POOL_SIZE=5
TASK_DB_MAX_OVERFLOW=10

# LangGraph checkpoint backend: sqlite or postgres.
CHECKPOINT_BACKEND=sqlite

# when CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=data/workflow.sqlite3

# when CHECKPOINT_BACKEND=postgres
# CHECKPOINT_POSTGRES_URL=postgresql://user:password@localhost:5432/workflow
